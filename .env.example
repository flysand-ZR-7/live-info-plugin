# ==============================================================================
# Live Information Plugin Configuration
# ==============================================================================

# Port and Host for the FastAPI server
HOST=0.0.0.0
PORT=8000

# SearXNG instance URL (running via docker-compose on port 8080)
SEARXNG_URL=http://localhost:8080

# Optional fallback search API (Brave Search API)
# Get a key at https://brave.com/search/api/
BRAVE_API_KEY=

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: "anthropic" (default), "openai", or "openai-compatible" (Ollama, vLLM, Groq, LM Studio)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# API key for the chosen provider (not required if using a local Ollama/vLLM server without auth)
LLM_API_KEY=sk-ant-api03-...

# Model name:
# - For Anthropic: "claude-3-5-sonnet-20241022", "claude-3-haiku-20240307"
# - For OpenAI: "gpt-4o", "gpt-4o-mini"
# - For Ollama / Local: "llama3.1:8b", "mistral-nemo", "qwen2.5:7b"
LLM_MODEL=claude-3-5-sonnet-20241022

# Optional custom base URL for OpenAI-compatible open-source servers:
# e.g., http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=

# ------------------------------------------------------------------------------
# Rate Limiting & Cache Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=600
READER_MAX_REDIRECTS=3
READER_TIMEOUT_SECONDS=10
READER_MAX_BYTES=5242880
